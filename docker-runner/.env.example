# Copy to `.env` and fill in. `.env` is gitignored — never commit a real token.

# ---- Auth (choose ONE) ----------------------------------------------------
# A PAT with org runner-admin rights. Recommended: the entrypoint exchanges it
# for a short-lived registration token at startup (PAT never written to disk),
# and can also mint a remove-token on shutdown for a clean deregister.
#   - Classic PAT scope:      admin:org
#   - Fine-grained PAT:       Organization permissions →
#                             "Self-hosted runners" = Read and write
GH_PAT=

# ...OR a pre-minted org registration token (Org → Settings → Actions →
# Runners → New runner). Short-lived (~1h). Leave GH_PAT blank if you use this.
# RUNNER_TOKEN=

# ---- Target ---------------------------------------------------------------
GITHUB_ORG=Bonkey-Apps

# ---- Runner identity / behaviour (optional) -------------------------------
# RUNNER_NAME=docker-mac-01
RUNNER_LABELS=docker,docker-mac,local
RUNNER_GROUP=Default
# true  → one job then exit (compose restarts it for the next job). Recommended.
# false → long-lived runner that stays online between jobs.
RUNNER_EPHEMERAL=true

# ---- Build / platform (optional) ------------------------------------------
RUNNER_VERSION=2.335.1
# Toolchain pins — keep in lockstep with IMAGE-MANIFEST.md + each repo's package.json.
PNPM_VERSION=10.33.0
PLAYWRIGHT_VERSION=1.61.1
# Bake the Java 17 + Android SDK + bundletool build toolchain (amd64 only).
# true  → full image, serves Gradle bundleRelease jobs for all three apps.
# false → lean JS/web-only image (also required for an arm64 build).
INSTALL_ANDROID=true
# linux/amd64 (default → reports x64, matches existing jobs) or linux/arm64.
# arm64 requires INSTALL_ANDROID=false (Android SDK is x86_64-host only).
RUNNER_PLATFORM=linux/amd64
# unless-stopped keeps ephemeral runners cycling; use "no" for a one-shot.
RUNNER_RESTART=unless-stopped
